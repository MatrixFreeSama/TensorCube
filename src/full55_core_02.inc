static void f55ApplyLocalMove(u32*site,u64*ori,const F55_Axes3*axes,int fixed,int layer,int dir){if(f55Get(*site,axes->a[fixed])!=layer)return;if(fixed==0){int x=f55Get(*site,axes->a[1]),y=f55Get(*site,axes->a[2]);if(dir>0){*site=f55Set(*site,axes->a[1],3-y);*site=f55Set(*site,axes->a[2],x);}else{*site=f55Set(*site,axes->a[1],y);*site=f55Set(*site,axes->a[2],3-x);}}else if(fixed==1){int x=f55Get(*site,axes->a[0]),z=f55Get(*site,axes->a[2]);if(dir>0){*site=f55Set(*site,axes->a[0],z);*site=f55Set(*site,axes->a[2],3-x);}else{*site=f55Set(*site,axes->a[0],3-z);*site=f55Set(*site,axes->a[2],x);}}else{int x=f55Get(*site,axes->a[0]),y=f55Get(*site,axes->a[1]);if(dir>0){*site=f55Set(*site,axes->a[0],3-y);*site=f55Set(*site,axes->a[1],x);}else{*site=f55Set(*site,axes->a[0],y);*site=f55Set(*site,axes->a[1],3-x);}}u64 no=0;for(int i=0;i<F55_D;i++)no=f55OriSet(no,i,f55RotateWorldSigned(f55OriField(*ori,i),axes,fixed,dir));*ori=no;}

static void f55SparseClear(F55_Sparse* A){A->n=0;A->pmask=0;}
static void f55QuerySparse(const F55_Sparse*A,u32 s,u32*d,u64*r){for(int i=0;i<A->n;i++)if(A->l[i].src==s){*d=A->l[i].dst;*r=A->l[i].rot;return;}*d=s;*r=f55OriId();}
static F55_Sparse f55ComposeSparse(const F55_Sparse*A,const F55_Sparse*B){F55_Sparse C;f55SparseClear(&C);C.pmask=A->pmask|B->pmask;u32 cand[32];int cn=0;for(int i=0;i<A->n;i++)cand[cn++]=A->l[i].src;for(int i=0;i<B->n;i++){int f=0;for(int j=0;j<cn;j++)if(cand[j]==B->l[i].src)f=1;if(!f)cand[cn++]=B->l[i].src;}for(int ii=0;ii<cn;ii++){u32 s=cand[ii],m,d;u64 rb,ra;f55QuerySparse(B,s,&m,&rb);f55QuerySparse(A,m,&d,&ra);u64 rr=f55OriCompose(ra,rb);if(d!=s||!f55OriIsId(rr)){if(C.n>=16){C.n=99;return C;}C.l[C.n].src=s;C.l[C.n].dst=d;C.l[C.n].rot=rr;C.n++;}}return C;}
static F55_Sparse f55InvSparse(const F55_Sparse*A){F55_Sparse B;f55SparseClear(&B);B.pmask=A->pmask;for(int i=0;i<A->n;i++){B.l[B.n].src=A->l[i].dst;B.l[B.n].dst=A->l[i].src;B.l[B.n].rot=f55OriInv(A->l[i].rot);B.n++;}return B;}
static int f55CycleSparse(const F55_Sparse*A,u32 a,u32 b,u32 c){u32 d;u64 r;f55QuerySparse(A,a,&d,&r);if(d!=b)return 0;f55QuerySparse(A,b,&d,&r);if(d!=c)return 0;f55QuerySparse(A,c,&d,&r);if(d!=a)return 0;for(int i=0;i<A->n;i++)if(A->l[i].src!=a&&A->l[i].src!=b&&A->l[i].src!=c)return 0;return 1;}

static void f55InitTables(){if(f55TablesReady)return;for(int i=0;i<11;i++)for(int j=i+1;j<11;j++)for(int k=j+1;k<11;k++){F55_Axes3 A={{(u8)i,(u8)j,(u8)k}};f55Triples[f55TripleN]=A;u16 m=(u16)((1u<<i)|(1u<<j)|(1u<<k));f55TripleMask[f55TripleN]=m;f55TripleN++;}for(u32 ci=0;ci<kLocalCycleCount;ci++){const LocalCycleDef*C=&kLocalCycles[ci];int cc[3];for(int z=0;z<3;z++)cc[z]=f55Code3(C->cyc[z][0],C->cyc[z][1],C->cyc[z][2]);for(int iv=0;iv<2;iv++){int s[3];if(!iv){s[0]=cc[0];s[1]=cc[1];s[2]=cc[2];}else{s[0]=cc[0];s[1]=cc[2];s[2]=cc[1];}for(int q=0;q<3;q++){u8*n=&f55PairOptN[C->b][s[q]][s[(q+1)%3]];if(*n<3){F55_Opt*o=&f55PairOpt[C->b][s[q]][s[(q+1)%3]][*n];o->wcode=(u8)s[(q+2)%3];o->ci=(u8)ci;o->inv=(u8)iv;(*n)++;}}}for(int z=0;z<3;z++){u8*n=&f55CycByVertN[C->b][cc[z]];if(*n<13)f55CycByVert[C->b][cc[z]][(*n)++]=(u16)ci;}}
 for(int dm=1;dm<2048;dm++){int pc=0;for(int b=0;b<11;b++)pc+=(dm>>b)&1;if(pc>3)continue;for(int t=0;t<f55TripleN;t++)if((f55TripleMask[t]&dm)==dm){u8*n=&f55TriplesByMaskN[dm];if(*n<45)f55TriplesByMask[dm][(*n)++]=(u16)t;}}
 f55TablesReady=1;}

static F55_Sparse f55MacroSparse(const F55_Axes3*axes,int ci,int inv,const u32 verts[3]){const LocalCycleDef*C=&kLocalCycles[ci];struct M{int fixed,layer,dir;};int a0=F55_AXPERM[C->api][0],a1=F55_AXPERM[C->api][1],a2=F55_AXPERM[C->api][2];M A={a0,C->macroSite[a0],1},B={a1,C->macroSite[a1],1},CC={a2,C->macroSite[a2],1};M w[10]={A,B,{A.fixed,A.layer,-1},{B.fixed,B.layer,-1},CC,B,A,{B.fixed,B.layer,-1},{A.fixed,A.layer,-1},{CC.fixed,CC.layer,-1}};F55_Sparse S;f55SparseClear(&S);S.pmask=(1ull<<f55PlaneIndex(axes->a[0],axes->a[1]))|(1ull<<f55PlaneIndex(axes->a[0],axes->a[2]))|(1ull<<f55PlaneIndex(axes->a[1],axes->a[2]));for(int z=0;z<3;z++){u32 p=verts[z];u64 o=f55OriId();if(!inv){for(int q=0;q<10;q++)f55ApplyLocalMove(&p,&o,axes,w[q].fixed,w[q].layer,w[q].dir);}else{for(int q=9;q>=0;q--)f55ApplyLocalMove(&p,&o,axes,w[q].fixed,w[q].layer,-w[q].dir);}S.l[S.n].src=verts[z];S.l[S.n].dst=p;S.l[S.n].rot=o;S.n++;}return S;}

static F55_Sparse f55StarSparse(const F55_Orbit*O,u32 v,int sign){F55_Sparse A;f55SparseClear(&A);u32 r=f55BasisSite[O->off],s=f55BasisSite[O->off+1],x=f55BasisSite[O->off+v];const F55_Star*T=&f55BasisStar[O->off+v];A.pmask=T->pmask;if(sign>0){A.l[A.n++]={r,s,T->rot[0]};A.l[A.n++]={s,x,T->rot[1]};A.l[A.n++]={x,r,T->rot[2]};}else{A.l[A.n++]={r,x,f55OriInv(T->rot[2])};A.l[A.n++]={x,s,f55OriInv(T->rot[1])};A.l[A.n++]={s,r,f55OriInv(T->rot[0])};}return A;}
static u32 f55Helper(const F55_Orbit*O,u32 b0,u32 b1,u32 b2,int nb){for(u32 x=2;x<O->n;x++){int ok=1;if(nb>0&&x==b0)ok=0;if(nb>1&&x==b1)ok=0;if(nb>2&&x==b2)ok=0;if(ok)return x;}return F55_BAD;}
static void f55WordPush(F55_Word*w,u32 v,int sg){w->v[w->n]=v;w->sg[w->n]=(i8)sg;w->n++;}
static F55_Word f55PairMapWord(const F55_Orbit*O,u32 a,u32 b){F55_Word w;w.n=0;
 if(a==0&&b==1)return w;
 if(b==0&&a>=2){f55WordPush(&w,a,1);return w;}
