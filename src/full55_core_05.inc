static int f55Emit3(F55_EmitCtx*ctx,u32 a,u32 b,u32 c){F55_Word w=f55ThreeCycleWord(a,b,c);for(int i=0;i<w.n;i++)if(!f55EmitStar(ctx,w.v[i],w.sg[i]))return 0;return 1;}
static int f55FactorPerm(const F55_Orbit*O,F55_EmitCtx*ctx){u32 n=O->n;for(u32 i=0;i<n;i++)f55Visited[i]=0;int pend=0;u32 pa=0,pb=0;for(u32 i=0;i<n;i++)if(!f55Visited[i]){u32 cur=i;f55Visited[cur]=1;u32 nxt=f55Perm[cur];while(nxt!=i){u32 a=i,b=nxt;if(!pend){pa=a;pb=b;pend=1;}else{u32 c=a,d=b,arr[4]={pa,pb,c,d},uni[4];int un=0;for(int ii=0;ii<4;ii++){int f=0;for(int j=0;j<un;j++)if(uni[j]==arr[ii])f=1;if(!f)uni[un++]=arr[ii];}if(un==3){u32 x=uni[0],y=x;if(x==pa)y=pb;else if(x==pb)y=pa;if(y==c)y=d;else if(y==d)y=c;if(y==x){x=uni[1];y=x;if(x==pa)y=pb;else if(x==pb)y=pa;if(y==c)y=d;else if(y==d)y=c;}u32 z=y;if(z==pa)z=pb;else if(z==pb)z=pa;if(z==c)z=d;else if(z==d)z=c;if(!f55Emit3(ctx,x,y,z))return 0;}else if(un==4){if(!f55Emit3(ctx,pa,pb,c)||!f55Emit3(ctx,pa,d,c))return 0;}else return 0;pend=0;}cur=nxt;f55Visited[cur]=1;nxt=f55Perm[cur];if(nxt>=n)return 0;}}
 return pend?0:1;}

// Caller supplies an unbiased 0..bound-1 random callback backed by source-style 256-bit+nonce ChaCha20.
typedef u32 (*F55_RandBoundFn)(void*ctx,u32 bound);
static int f55Scramble(F55_RandBoundFn rb,void*rctx,u64*starOps){if(!f55BuildBasis())return 0;f55StateIdentity();if(starOps)*starOps=0;for(int k=1;k<=11;k++){F55_Orbit O={k,F55_ORBIT_OFF[k],F55_ORBIT_N[k],f55OrbitMask[k]};u32 n=O.n;for(u32 i=0;i<n;i++)f55Perm[i]=i;int parity=0;for(u32 ii=n-1;ii>0;ii--){u32 j=rb(rctx,ii+1);if(j>ii)return 0;if(j!=ii){u32 t=f55Perm[ii];f55Perm[ii]=f55Perm[j];f55Perm[j]=t;parity^=1;}}if(parity){u32 t=f55Perm[0];f55Perm[0]=f55Perm[1];f55Perm[1]=t;}F55_EmitCtx ec={1,&O,starOps};if(!f55FactorPerm(&O,&ec))return 0;}return f55Pop(f55ScramblePlaneMask)==55;}
static int f55SolveStateOnly(u64*starOps){if(!f55BasisReady)return 0;f55PlanCount=0;f55PlanPlaneMask=0;if(starOps)*starOps=0;for(int k=1;k<=11;k++){F55_Orbit O={k,F55_ORBIT_OFF[k],F55_ORBIT_N[k],f55OrbitMask[k]};u32 st=f55PlanCount;f55PlanStart[k]=st;for(u32 i=0;i<O.n;i++){u32 gid=f55BasisSite[O.off+i],cur=f55SiteOfId[gid],gr=f55BasisRankBySite[cur];if(gr==F55_BAD||gr<O.off||gr>=O.off+O.n)return 0;f55Perm[i]=gr-O.off;}F55_EmitCtx ec={2,&O,starOps};if(!f55FactorPerm(&O,&ec))return 0;u32 en=f55PlanCount;/* factorization reconstructed from current permutation; turn it into the exact inverse word, without consulting scramble metadata. */for(u32 a=st,b=en?en-1:0;a<b;a++,b--){u32 x=f55Plan[a]^(1u<<20),y=f55Plan[b]^(1u<<20);f55Plan[a]=y;f55Plan[b]=x;}if(en>st&&((en-st)&1u))f55Plan[st+(en-st)/2]^=(1u<<20);f55PlanLen[k]=en-st;}return f55Pop(f55PlanPlaneMask)==55;}
static int f55ExactVerify(){u64 oid=f55OriId();for(int k=1;k<=11;k++){F55_Orbit O={k,F55_ORBIT_OFF[k],F55_ORBIT_N[k],f55OrbitMask[k]};for(u32 s=0;s<O.n;s++){u32 curGlobal=f55BasisSite[O.off+s],gid=f55IdAtSite[curGlobal],lr=f55BasisRankBySite[gid];if(lr==F55_BAD||lr<O.off||lr>=O.off+O.n)return 0;f55VerifyIdAt[s]=lr-O.off;}for(u32 i=0;i<O.n;i++){u32 gid=f55BasisSite[O.off+i],cur=f55SiteOfId[gid],lr=f55BasisRankBySite[cur];if(lr==F55_BAD||lr<O.off||lr>=O.off+O.n)return 0;f55VerifySiteOf[i]=lr-O.off;f55VerifyOri[i]=f55OriOfId[gid];}u32 st=f55PlanStart[k],en=st+f55PlanLen[k];for(u32 z=st;z<en;z++){u32 q=f55Plan[z],v=q&0xfffffu,sg=(q&(1u<<20))?-1:1;if(((q>>21)&15u)!=(u32)k)return 0;f55ApplyStarVerify(&O,v,sg);}for(u32 i=0;i<O.n;i++)if(f55VerifyIdAt[i]!=i||f55VerifySiteOf[i]!=i||f55VerifyOri[i]!=oid)return 0;}return 1;}
static void f55ApplyPlanPrefix(u32 target,u32*applied){if(target>f55PlanCount)target=f55PlanCount;while(*applied<target){u32 q=f55Plan[*applied],v=q&0xfffffu,sg=(q&(1u<<20))?-1:1,k=(q>>21)&15u;F55_Orbit O={(int)k,F55_ORBIT_OFF[k],F55_ORBIT_N[k],f55OrbitMask[k]};f55ApplyStarGlobal(&O,v,sg);(*applied)++;}}
static int f55StateIsIdentity(){u64 o=f55OriId();for(u32 i=0;i<F55_TOTAL;i++)if(f55IdAtSite[i]!=i||f55SiteOfId[i]!=i||f55OriOfId[i]!=o)return 0;return 1;}

